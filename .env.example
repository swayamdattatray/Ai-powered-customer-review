# ==============================================================================
# AI Customer Review Intelligence & Price Comparison - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your official API credentials.
# Never commit the .env file with real credentials to version control.

# Flask Application Secret Key
SECRET_KEY=change-this-secret-key-to-something-secure

# ------------------------------------------------------------------------------
# 1. Amazon Product Advertising API 5.0 (PA-API 5.0)
# ------------------------------------------------------------------------------
# Requirements:
#   - Active Amazon Associates Account (https://affiliate-program.amazon.in/)
#   - Approved access to Product Advertising API
# Documentation:
#   https://webservices.amazon.in/paapi5/documentation/
AMAZON_ACCESS_KEY=your_amazon_paapi_access_key_here
AMAZON_SECRET_KEY=your_amazon_paapi_secret_key_here
AMAZON_PARTNER_TAG=your_amazon_associates_partner_tag_here
AMAZON_COUNTRY=IN

# ------------------------------------------------------------------------------
# 2. Flipkart Affiliate API
# ------------------------------------------------------------------------------
# Requirements:
#   - Registered Flipkart Affiliate Account (https://affiliate.flipkart.com/)
#   - Affiliate API Token generated from dashboard (API > API Token)
# Documentation:
#   https://affiliate.flipkart.com/api-docs/
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id_here
FLIPKART_AFFILIATE_TOKEN=your_flipkart_affiliate_token_here
